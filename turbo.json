{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@my-finance/shared#build": {
      "outputs": []
    },
    "@my-finance/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["../web/dist/_worker.js"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
